From 9f2049a37290c77df96b9e8c111c9b8525cbf3a3 Mon Sep 17 00:00:00 2001
From: lemonade1921 <joandegenover1@gmail.com>
Date: Sat, 31 Oct 2026 02:33:26 +0100
Subject: [PATCH] Smooth trackpad pinch-to-zoom on macOS

On macOS a trackpad pinch arrives as a burst of ctrl+wheel events with small
fractional deltas. Each event was mapped to a full zoomIn()/zoomOut() step and
a full re-render, so pinching jumped through zoom levels and stuttered.

Add Common.Utils.SmoothWheelZoom, which converts wheel deltas into a
continuous zoom factor (e^(-deltaY/100), matching Chromium's pinch scale),
accumulates them and applies at most one zoom per frame (~33 fps). Used by the
document, spreadsheet, presentation, PDF and diagram editors for pixel-precise
wheel input on macOS; line/page-mode mouse wheels keep the stepped zoom.
---
 apps/common/main/lib/util/utils.js            | 103 ++++++++++++++++++
 .../main/app/controller/DocumentHolder.js     |   7 +-
 .../main/app/controller/DocumentHolder.js     |   6 +-
 .../main/app/controller/DocumentHolder.js     |   7 +-
 .../main/app/controller/DocumentHolder.js     |  15 ++-
 .../main/app/controller/DocumentHolder.js     |   6 +-
 6 files changed, 139 insertions(+), 5 deletions(-)

diff --git a/apps/common/main/lib/util/utils.js b/apps/common/main/lib/util/utils.js
index b322d9c4..634a065b 100644
--- a/apps/common/main/lib/util/utils.js
+++ b/apps/common/main/lib/util/utils.js
@@ -1669,4 +1669,107 @@ define([], function () {
 
         return (typeof val === 'number') ||  !(val === '' || !regstr.test(val.trim()) || isNaN(parseFloat(val)));
     };
+
+    /*
+     * Smooth ctrl+wheel / trackpad-pinch zoom.
+     *
+     * On macOS a trackpad pinch reaches the page as a burst of `wheel` events with
+     * ctrlKey set and small fractional deltaY values (dozens per second). The editors
+     * used to map every one of those events to a full zoomIn()/zoomOut() step
+     * (+-10% or more) and a full document re-render, so a gentle pinch jumped
+     * through several zoom levels and the UI stuttered.
+     *
+     * This helper turns the deltas into a continuous zoom factor, accumulates them
+     * and applies at most one zoom per animation frame.
+     *
+     * options:
+     *   getZoom()        -> current zoom in percent
+     *   setZoom(percent) -> apply zoom in percent
+     *   min, max         -> zoom limits in percent
+     */
+    Common.Utils.SmoothWheelZoom = function (options) {
+        this.options = options || {};
+        this._target = null;
+        this._raf = null;
+        this._lastApply = 0;
+        this._idleTimer = null;
+    };
+
+    // For the document/presentation/pdf/visio APIs: zoom is set with api.zoom(percent)
+    // and reported through 'asc_onZoomChange'. Call from the controller's setApi().
+    Common.Utils.SmoothWheelZoom.attachToDocApi = function (api, min, max) {
+        var current = 100;
+        api.asc_registerCallback('asc_onZoomChange', function (percent) {
+            if (percent > 0) current = percent;
+        });
+        return new Common.Utils.SmoothWheelZoom({
+            getZoom: function () { return current; },
+            setZoom: function (percent) { api.zoom(percent); },
+            min: min,
+            max: max
+        });
+    };
+
+    Common.Utils.SmoothWheelZoom.prototype = {
+        SENSITIVITY: 0.01,       // zoom factor per pixel of deltaY: e^(-deltaY * k)
+        MAX_EVENT_DELTA: 30,     // clamp per-event delta so a mouse notch isn't a huge jump
+        MIN_FRAME_INTERVAL: 30,  // ms between re-renders (~33 fps), zooming is expensive
+        IDLE_RESET: 250,         // ms after the gesture ends before re-reading zoom from the editor
+
+        // Use the smooth path only for pixel-precise wheel input on macOS (trackpads, Magic Mouse).
+        canHandle: function (event) {
+            var e = event && event.originalEvent ? event.originalEvent : event;
+            return !!(Common.Utils.isMac && e && typeof e.deltaY === 'number' && !e.deltaMode);
+        },
+
+        handle: function (event) {
+            var e = event.originalEvent ? event.originalEvent : event,
+                dy = e.deltaY;
+            if (!dy) return;
+
+            dy = Math.max(-this.MAX_EVENT_DELTA, Math.min(this.MAX_EVENT_DELTA, dy));
+
+            if (this._target === null) {
+                var cur = this.options.getZoom();
+                if (!(cur > 0)) return;
+                this._target = cur;
+            }
+
+            this._target *= Math.exp(-dy * this.SENSITIVITY);
+            this._target = Math.max(this.options.min, Math.min(this.options.max, this._target));
+
+            this._schedule();
+
+            var me = this;
+            clearTimeout(this._idleTimer);
+            this._idleTimer = setTimeout(function () {
+                me._flush();
+                me._target = null;
+            }, this.IDLE_RESET);
+        },
+
+        _schedule: function () {
+            if (this._raf !== null) return;
+            var me = this,
+                raf = window.requestAnimationFrame || function (cb) { return setTimeout(cb, 16); };
+            this._raf = raf(function () {
+                me._raf = null;
+                var now = Date.now();
+                if (now - me._lastApply < me.MIN_FRAME_INTERVAL) {
+                    me._schedule();
+                    return;
+                }
+                me._flush();
+            });
+        },
+
+        _flush: function () {
+            if (this._target === null) return;
+            var value = Math.round(this._target);
+            if (value !== Math.round(this.options.getZoom())) {
+                this._lastApply = Date.now();
+                this.options.setZoom(value);
+            }
+        }
+    };
 });
\ No newline at end of file

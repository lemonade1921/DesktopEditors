diff --git a/apps/common/main/lib/util/utils.js b/apps/common/main/lib/util/utils.js
index b322d9c4..8fbb975d 100644
--- a/apps/common/main/lib/util/utils.js
+++ b/apps/common/main/lib/util/utils.js
@@ -1669,4 +1669,230 @@ define([], function () {
 
         return (typeof val === 'number') ||  !(val === '' || !regstr.test(val.trim()) || isNaN(parseFloat(val)));
     };
+
+    /*
+     * Smooth ctrl+wheel / trackpad-pinch zoom.
+     *
+     * On macOS a trackpad pinch reaches the page as a burst of `wheel` events with
+     * ctrlKey set and small fractional deltaY values (60+ per second). The editors
+     * mapped every event to a full zoomIn()/zoomOut() step plus a full document
+     * re-render, so pinching jumped between zoom levels and stuttered.
+     *
+     * Re-rendering a document is far too slow to do on every frame, so this works
+     * the way browsers and native viewers do:
+     *   1. while the fingers move, the canvases that are already drawn are scaled
+     *      with a CSS transform (GPU only, follows the fingers every frame);
+     *   2. when the gesture pauses, the real zoom is applied once, and the preview
+     *      transform is dropped in the same frame the editor redraws, so there is
+     *      no flash or jump between the preview and the sharp result.
+     *
+     * options:
+     *   getZoom()        -> current zoom in percent
+     *   setZoom(percent) -> apply zoom in percent
+     *   min, max         -> zoom limits in percent
+     *   getView()        -> { el: element whose children are the document canvases,
+     *                         origin: 'center' | 'topleft' }  (where the editor
+     *                         keeps the document fixed when it zooms)
+     */
+    Common.Utils.SmoothWheelZoom = function (options) {
+        this.options = options || {};
+        this._target = null;     // zoom the fingers are asking for
+        this._shown = null;      // zoom of what's currently drawn on the canvases
+        this._pending = null;    // zoom applied to the editor, waiting for its redraw
+        this._view = null;
+        this._raf = null;
+        this._idleTimer = null;
+        this._fallbackTimer = null;
+        this._hooks = [];
+    };
+
+    // For the document/presentation/pdf/visio APIs: zoom is set with api.zoom(percent)
+    // and reported through 'asc_onZoomChange'. Call from the controller's setApi().
+    Common.Utils.SmoothWheelZoom.attachToDocApi = function (api, min, max) {
+        var current = 100;
+        api.asc_registerCallback('asc_onZoomChange', function (percent) {
+            if (percent > 0) current = percent;
+        });
+        return new Common.Utils.SmoothWheelZoom({
+            getZoom: function () { return current; },
+            setZoom: function (percent) { api.zoom(percent); },
+            min: min,
+            max: max,
+            getView: function () {
+                var c = document.getElementById('id_viewer');
+                return c && c.parentElement ? { el: c.parentElement, origin: 'center' } : null;
+            }
+        });
+    };
+
+    Common.Utils.SmoothWheelZoom.prototype = {
+        SENSITIVITY: 0.01,      // zoom factor per pixel of deltaY: e^(-deltaY/100), Chromium's pinch scale
+        MAX_EVENT_DELTA: 30,    // clamp per-event delta so a mouse notch isn't a huge jump
+        COMMIT_DELAY: 160,      // ms without pinch events before the real zoom is applied
+        REDRAW_TIMEOUT: 400,    // ms to wait for the editor's redraw before dropping the preview anyway
+
+        // Use the smooth path only for pixel-precise wheel input on macOS (trackpads, Magic Mouse).
+        canHandle: function (event) {
+            var e = event && event.originalEvent ? event.originalEvent : event;
+            return !!(Common.Utils.isMac && e && typeof e.deltaY === 'number' && !e.deltaMode);
+        },
+
+        handle: function (event) {
+            var e = event.originalEvent ? event.originalEvent : event,
+                dy = e.deltaY;
+            if (!dy) return;
+
+            dy = Math.max(-this.MAX_EVENT_DELTA, Math.min(this.MAX_EVENT_DELTA, dy));
+
+            if (this._target === null) {
+                var cur = this.options.getZoom();
+                if (!(cur > 0)) return;
+                this._target = cur;
+                if (this._shown === null) this._shown = cur;
+            }
+
+            this._target *= Math.exp(-dy * this.SENSITIVITY);
+            this._target = Math.max(this.options.min, Math.min(this.options.max, this._target));
+
+            this._schedulePreview();
+
+            var me = this;
+            clearTimeout(this._idleTimer);
+            this._idleTimer = setTimeout(function () { me._commit(); }, this.COMMIT_DELAY);
+        },
+
+        // ---- live preview -------------------------------------------------------
+
+        _schedulePreview: function () {
+            if (this._raf !== null) return;
+            var me = this,
+                raf = window.requestAnimationFrame || function (cb) { return setTimeout(cb, 16); };
+            this._raf = raf(function () {
+                me._raf = null;
+                me._applyPreview();
+            });
+        },
+
+        _getView: function () {
+            if (this._view && document.body.contains(this._view.el)) return this._view;
+            this._view = this.options.getView ? this.options.getView() : null;
+            return this._view;
+        },
+
+        _applyPreview: function () {
+            var view = this._getView();
+            if (!view || this._target === null || !(this._shown > 0)) return;
+
+            var scale = this._target / this._shown;
+            if (Math.abs(scale - 1) < 0.001) { this._clearPreview(); return; }
+
+            var el = view.el,
+                ox = view.origin === 'topleft' ? 0 : el.clientWidth / 2,
+                oy = view.origin === 'topleft' ? 0 : el.clientHeight / 2;
+
+            if (!this._saved) {
+                this._saved = { overflow: el.style.overflow };
+                el.style.overflow = 'hidden';
+            }
+            for (var i = 0; i < el.children.length; i++) {
+                var c = el.children[i];
+                if (c._swzSaved === undefined)
+                    c._swzSaved = { t: c.style.transform, o: c.style.transformOrigin, w: c.style.willChange };
+                // each child is positioned inside the view, so express the shared origin in its own coordinates
+                c.style.willChange = 'transform';
+                c.style.transformOrigin = (ox - c.offsetLeft) + 'px ' + (oy - c.offsetTop) + 'px';
+                c.style.transform = 'scale(' + scale + ')';
+            }
+        },
+
+        _clearPreview: function () {
+            var view = this._view;
+            if (!view || !this._saved) return;
+            var el = view.el;
+            for (var i = 0; i < el.children.length; i++) {
+                var c = el.children[i];
+                if (c._swzSaved !== undefined) {
+                    c.style.transform = c._swzSaved.t;
+                    c.style.transformOrigin = c._swzSaved.o;
+                    c.style.willChange = c._swzSaved.w;
+                    delete c._swzSaved;
+                }
+            }
+            el.style.overflow = this._saved.overflow;
+            this._saved = null;
+        },
+
+        // ---- real zoom ----------------------------------------------------------
+
+        _commit: function () {
+            if (this._target === null) return;
+            var value = Math.round(this._target),
+                cur = this.options.getZoom();
+            this._target = null;
+
+            if (value === Math.round(cur)) {
+                this._shown = null;
+                this._clearPreview();
+                return;
+            }
+
+            var me = this;
+            this._pending = value;
+            // The editor draws on its own paint loop. Watch the canvases and swap the
+            // preview for the real render in the same task that draws it.
+            this._hookRedraw(function () { me._onRedraw(); });
+            clearTimeout(this._fallbackTimer);
+            this._fallbackTimer = setTimeout(function () { me._onRedraw(); }, this.REDRAW_TIMEOUT);
+
+            this.options.setZoom(value);
+        },
+
+        _onRedraw: function () {
+            if (this._pending === null) return;
+            this._unhookRedraw();
+            clearTimeout(this._fallbackTimer);
+            this._pending = null;
+            var actual = this.options.getZoom();     // the editor may have clamped the value
+
+            if (this._target !== null) {
+                // fingers are still moving: keep previewing, relative to the new render
+                this._shown = actual;
+                this._applyPreview();
+            } else {
+                this._shown = null;
+                this._clearPreview();
+            }
+        },
+
+        _hookRedraw: function (cb) {
+            this._unhookRedraw();
+            var view = this._getView();
+            if (!view) return;
+            // Watch only the main (largest) canvas: overlays repaint on their own
+            // (selection, cursor) and would end the preview too early.
+            var canvases = view.el.getElementsByTagName('canvas'),
+                main = null, area = 0;
+            for (var i = 0; i < canvases.length; i++) {
+                var a = canvases[i].width * canvases[i].height;
+                if (a > area) { area = a; main = canvases[i]; }
+            }
+            var ctx = main ? main.getContext('2d') : null;
+            if (!ctx) return;
+            var me = this,
+                fired = false,
+                fire = function () { if (!fired) { fired = true; cb(); } };
+            ['drawImage', 'fillRect', 'clearRect', 'putImageData'].forEach(function (name) {
+                if (Object.prototype.hasOwnProperty.call(ctx, name)) return;
+                var orig = ctx[name];
+                ctx[name] = function () { fire(); return orig.apply(this, arguments); };
+                me._hooks.push({ ctx: ctx, name: name });
+            });
+        },
+
+        _unhookRedraw: function () {
+            for (var i = 0; i < this._hooks.length; i++)
+                delete this._hooks[i].ctx[this._hooks[i].name];
+            this._hooks = [];
+        }
+    };
 });
\ No newline at end of file
